# PharmaStock Backend — Environment Configuration
# Copy this file to .env and fill in your real values.

# Port for the Express server
PORT=5000

# MongoDB connection string.
# Local MongoDB (Option B):
MONGODB_URI=mongodb://localhost:27017/pharma_stock_management

# MongoDB Atlas (Option A) — replace USERNAME, PASSWORD, CLUSTER:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/pharma_stock_management?retryWrites=true&w=majority

# JWT secret used for signing authentication tokens
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Required only for the intentionally destructive demo seed
SEED_CONFIRM=RESET
SEED_PASSWORD=replace_with_a_local_seed_password
